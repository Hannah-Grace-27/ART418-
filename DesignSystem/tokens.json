{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Super Stager Brand & Design System",
  "version": "1.0.0",
  "color": {
    "primary": {
      "mint-green": {
        "value": "#6FC774",
        "type": "color",
        "description": "Energetic, fresh mint green representing growth, vitality, and organized spaces"
      },
      "deep-pool": {
        "value": "#057FA8",
        "type": "color",
        "description": "Deep ocean pool teal/cyan representing calm, clarity, and structural reliability"
      },
      "red-plum": {
        "value": "#A80550",
        "type": "color",
        "description": "Vibrant retro plum/magenta used for high-impact actions, badges, and attention"
      },
      "sunny": {
        "value": "#EBC25B",
        "type": "color",
        "description": "Warm retro golden yellow representing optimism, energy, and hero highlights"
      }
    },
    "neutral": {
      "canvas": {
        "value": "#FCF7F0",
        "type": "color",
        "description": "Warm retro cream canvas background for soft, inviting, paper-like warmth"
      },
      "surface": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Pure white for cards, elevated surfaces, and input elements"
      },
      "border": {
        "value": "#EDE9DF",
        "type": "color",
        "description": "Soft warm beige-gray for subtle borders and dividers"
      },
      "ink": {
        "value": "#000000",
        "type": "color",
        "description": "Deep ink black for high-contrast headers, outlines, and body typography"
      },
      "ink-muted": {
        "value": "#595959",
        "type": "color",
        "description": "Medium contrast slate for secondary labels and metadata"
      }
    },
    "status": {
      "staged": {
        "value": "#057FA8",
        "type": "color",
        "description": "Item currently staged at client property"
      },
      "in-warehouse": {
        "value": "#6FC774",
        "type": "color",
        "description": "Item available in warehouse"
      },
      "in-transit": {
        "value": "#EBC25B",
        "type": "color",
        "description": "Item moving or on truck"
      },
      "maintenance": {
        "value": "#A80550",
        "type": "color",
        "description": "Damaged or needs repair"
      }
    }
  },
  "typography": {
    "fontFamilies": {
      "header": {
        "value": "BC Alphapipe, 'Fredoka', 'Dela Gothic One', sans-serif",
        "type": "fontFamilies",
        "description": "Bold, expressive, curved retro display font for titles and headers"
      },
      "subhead": {
        "value": "Lato, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "type": "fontFamilies",
        "description": "Clean, highly legible humanist sans-serif for subheadings, navigation, and body"
      },
      "decorative": {
        "value": "All Round Gothic, 'Comfortaa', 'Quicksand', sans-serif",
        "type": "fontFamilies",
        "description": "Geometric rounded book font for badges, accents, and callouts"
      }
    },
    "fontSize": {
      "xs": { "value": "12px", "type": "dimension" },
      "sm": { "value": "14px", "type": "dimension" },
      "base": { "value": "16px", "type": "dimension" },
      "lg": { "value": "20px", "type": "dimension" },
      "xl": { "value": "24px", "type": "dimension" },
      "2xl": { "value": "32px", "type": "dimension" },
      "3xl": { "value": "40px", "type": "dimension" },
      "hero": { "value": "56px", "type": "dimension" }
    },
    "fontWeight": {
      "regular": { "value": "400", "type": "fontWeight" },
      "medium": { "value": "500", "type": "fontWeight" },
      "bold": { "value": "700", "type": "fontWeight" },
      "black": { "value": "900", "type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "value": "1.1", "type": "lineHeight" },
      "snug": { "value": "1.25", "type": "lineHeight" },
      "normal": { "value": "1.5", "type": "lineHeight" },
      "relaxed": { "value": "1.75", "type": "lineHeight" }
    }
  },
  "radii": {
    "none": { "value": "0px", "type": "borderRadius" },
    "sm": { "value": "8px", "type": "borderRadius" },
    "md": { "value": "16px", "type": "borderRadius" },
    "lg": { "value": "24px", "type": "borderRadius" },
    "pill": { "value": "9999px", "type": "borderRadius" }
  },
  "spacing": {
    "2xs": { "value": "4px", "type": "spacing" },
    "xs": { "value": "8px", "type": "spacing" },
    "sm": { "value": "12px", "type": "spacing" },
    "md": { "value": "16px", "type": "spacing" },
    "lg": { "value": "24px", "type": "spacing" },
    "xl": { "value": "32px", "type": "spacing" },
    "2xl": { "value": "48px", "type": "spacing" }
  },
  "shadows": {
    "retro-sm": {
      "value": "2px 2px 0px #000000",
      "type": "boxShadow"
    },
    "retro-md": {
      "value": "4px 4px 0px #000000",
      "type": "boxShadow"
    },
    "retro-lg": {
      "value": "6px 6px 0px #000000",
      "type": "boxShadow"
    },
    "soft": {
      "value": "0px 8px 24px rgba(0, 0, 0, 0.06)",
      "type": "boxShadow"
    }
  }
}
